# Application
APP_NAME=Enterprise Agentic RAG
ENVIRONMENT=development
DEBUG=true

# Gemini Embeddings
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=3072

# Qdrant
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag

# Upload limits
MAX_UPLOAD_SIZE_MB=50
